# Configurações do Servidor e Jogo Ravena RPG

# Porta do servidor HTTP e WebSocket
PORT=12000

# Endereço/Interface de escuta (0.0.0.0 para todas as interfaces)
HOST=0.0.0.0

# Domínio público da aplicação (sem protocolo)
# Exemplo em produção: pescavena.moothz.com
# Exemplo em desenvolvimento local: localhost:12000
DOMAIN=pescavena.moothz.com

# Habilita HTTPS e WSS nos links gerados para o cliente (true para produção com SSL, false para desenvolvimento puro HTTP)
USE_SSL=true

# Origens autorizadas para requisições e WebSocket (separadas por vírgula)
# Se não definido, é inferido automaticamente a partir de DOMAIN e USE_SSL
ALLOWED_ORIGINS=https://pescavena.moothz.com,http://localhost:12000

# URLs explícitas de API e WebSocket (opcional; se omitidas, são geradas automaticamente a partir de DOMAIN e USE_SSL)
# API_URL=https://pescavena.moothz.com
# WS_URL=wss://pescavena.moothz.com/ws

# Caminho para armazenamento persistente de contas e sessões
ACCOUNT_DATA_FILE=./server/data/accounts.json
